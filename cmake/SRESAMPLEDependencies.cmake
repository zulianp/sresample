# Optional dependencies. A parent project (sfem) may already provide them as targets.

if(SRESAMPLE_ENABLE_OPENMP)
    if(NOT TARGET OpenMP::OpenMP_CXX)
        find_package(OpenMP REQUIRED COMPONENTS CXX)
    endif()
endif()

if(SRESAMPLE_ENABLE_MPI)
    if(NOT TARGET MPI::MPI_CXX)
        find_package(MPI REQUIRED COMPONENTS CXX)
    endif()
endif()

if(SRESAMPLE_ENABLE_CUDA)
    include(CheckLanguage)
    check_language(CUDA)
    enable_language(CUDA)
    if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
        set(CMAKE_CUDA_ARCHITECTURES 90)
    endif()
    if(NOT DEFINED CMAKE_CUDA_STANDARD)
        set(CMAKE_CUDA_STANDARD 17)
        set(CMAKE_CUDA_STANDARD_REQUIRED ON)
    endif()
    find_package(CUDAToolkit REQUIRED)
endif()

if(SRESAMPLE_ENABLE_SMESH)
    if(NOT TARGET smesh::smesh)
        find_package(smesh CONFIG REQUIRED)
    endif()
endif()

# The instantiation lists: every tuple, and the distinct (real, geom, idx) and real types.
function(sresample_type_name out name)
    if(name STREQUAL "float32")
        set(${out} "float" PARENT_SCOPE)
    elseif(name STREQUAL "float64")
        set(${out} "double" PARENT_SCOPE)
    elseif(name STREQUAL "int32")
        set(${out} "int32_t" PARENT_SCOPE)
    elseif(name STREQUAL "int64")
        set(${out} "int64_t" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "sresample: unknown type ${name} in SRESAMPLE_INSTANTIATIONS")
    endif()
endfunction()

set(_sresample_tuples "${SRESAMPLE_INSTANTIATIONS}")
list(REMOVE_DUPLICATES _sresample_tuples)
set(SRESAMPLE_FOREACH_TYPES "")
set(_mesh_types "")
set(_real_types "")
foreach(_tuple ${_sresample_tuples})
    string(REPLACE "," ";" _names "${_tuple}")
    list(LENGTH _names _n)
    if(NOT _n EQUAL 4)
        message(FATAL_ERROR "sresample: '${_tuple}' is not real,geom,idx,grid")
    endif()
    list(GET _names 0 _r)
    list(GET _names 1 _g)
    list(GET _names 2 _i)
    list(GET _names 3 _s)
    sresample_type_name(_r ${_r})
    sresample_type_name(_g ${_g})
    sresample_type_name(_i ${_i})
    sresample_type_name(_s ${_s})
    string(APPEND SRESAMPLE_FOREACH_TYPES " X(${_r}, ${_g}, ${_i}, ${_s})")
    list(APPEND _mesh_types "${_r}, ${_g}, ${_i}")
    list(APPEND _real_types "${_r}")
endforeach()
list(REMOVE_DUPLICATES _mesh_types)
list(REMOVE_DUPLICATES _real_types)
set(SRESAMPLE_FOREACH_MESH_TYPES "")
foreach(_t ${_mesh_types})
    string(APPEND SRESAMPLE_FOREACH_MESH_TYPES " X(${_t})")
endforeach()
set(SRESAMPLE_FOREACH_REAL_TYPES "")
foreach(_t ${_real_types})
    string(APPEND SRESAMPLE_FOREACH_REAL_TYPES " X(${_t})")
endforeach()
